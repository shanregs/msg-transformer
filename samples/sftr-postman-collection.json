{
  "info": {
    "name": "SFTR Mapping Engine - test message endpoint",
    "description": "Sends one message at a time to POST /api/test-message, which runs the whole flow (reference data, mapping rules, write to the CSV).\n\nStart the app with the rest or both profile (see docs/running-locally.md) and the reference-data stub (python samples/refdata-stub.py). Change the baseUrl collection variable if the port is not 8080.\n\nFolder D needs the app started with --sftr.output.write-mode=COUNT --sftr.output.batch-size=3; run its requests in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "A. Rows are written",
      "item": [
        {
          "name": "A1 London entity, trade PO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const r = pm.response.json();",
                  "pm.test('outcome is WRITTEN', function () { pm.expect(r.outcome).to.eql('WRITTEN'); });",
                  "pm.test('no rejects file', function () { pm.expect(r.rejectsFile).to.eql(null); });",
                  "pm.test('report file is named', function () { pm.expect(r.reportFile).to.include('sftr-report'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Expect one CSV row: CP_RepCp 549300CP1 plus zeros, CP_NatureOfRepCp C, CP_SecOfRepCp CDTI, CP_BranchOfRepCp GB (the LDNBB prefix is a London entity), CP_CpSide GIVE (PO is a GIVE code).",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trade_ref\": \"A1\",\n  \"trade_type\": \"PO\",\n  \"bmoLegalEntity\": \"LDNBB01\",\n  \"counterpartyId\": \"CP1\",\n  \"group_cd\": \"G1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/test-message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test-message"
              ]
            }
          }
        },
